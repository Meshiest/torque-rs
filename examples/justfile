set windows-shell := ["powershell", "-NoProfile", "-Command"]

# The build folder: CARGO_TARGET_DIR's, else the workspace's (the web builds go into its `web` folder)
web_target := env_var_or_default("CARGO_TARGET_DIR", justfile_directory() / ".." / "target")

# Where the web check's tools (puppeteer-core) are installed; exported so the recipes need no shell-specific syntax
export TORQUE_WEB_TOOLS := web_target / "web-tools" / "node"

default:
    @just --list

# The headless examples: the umbrella crate's examples and a short run of the minimal server
headless:
    cargo run -p torque --example script
    cargo run -p torque --example shape
    cargo run -p torque --example collide
    cargo run -p torque --example net
    cargo run -p torque-example --bin min-server -- --port 0 --ticks 64

# The minimal dedicated server: the bundled game on 127.0.0.1:28000 (`--ticks N` stops it after N ticks)
min-server *args:
    cargo run -p torque-example --bin min-server -- {{args}}

# The minimal client: connects to the minimal server and prints the ghosts it is sent
min-client *args:
    cargo run -p torque-example --bin min-client -- {{args}}

# The example games' asset kit (shapes and textures made from code), written into `dir`
assets dir="../target/example-assets":
    cargo run -p torque-example-assets -- {{dir}}

# The animated character example in a window (W A S D walk, Shift sprint, Ctrl or C crouch, Z prone, Space jump, F pistol, mouse
# or Q/E orbit, Esc quit)
character:
    cargo run -p torque-example-character --release

# The character example's idle, walk and jump pictures, drawn offscreen into `dir`
character-shots dir="../target/character-shots":
    cargo run -p torque-example-character --release -- --shots {{dir}}

# The level demo in a window: a menu of maps, then the box figure on them (W A S D walk, Shift sprint, Ctrl or C crouch, Z prone,
# Space jump, mouse look, Tab camera, R restart, Esc menu)
level-demo:
    cargo run -p torque-example-level-demo --release

# The level demo in a browser (WebGPU): built for the web, then served on http://127.0.0.1:{{port}}/ (`?map=office` starts a map
# at once). The page shows each loading stage, fetches the files by their list (`files.json`) and keeps them in the browser's
# cache; its gear opens the settings (the quality, Firefox starting at Low; the frame rate, also F8).
# Needs rustup's wasm32-unknown-unknown target and Node; wasm-bindgen's command line is installed into the target folder's
# web-tools the first time
web-level-demo port="8080":
    node ../web/build.mjs level-demo
    node ../web/serve.mjs "{{web_target}}/web/level-demo" {{port}}

# The level demo in a browser with its files inside the module (no list, nothing fetched but the page and the module)
web-level-demo-embedded port="8080":
    node ../web/build.mjs level-demo --embed
    node ../web/serve.mjs "{{web_target}}/web/level-demo-embedded" {{port}}

# The web pages' loading display, settings, script bridge, browser host and connection codes, tested in Node (no browser)
web-unit:
    node --test ../web/loading.test.mjs ../web/settings.test.mjs ../web/bridge.test.mjs ../web/host.test.mjs ../web/codes.test.mjs ../web/invites.test.mjs

# Fails when any script in the repository could open a browser other than through `launchGuarded` (web/guard.mjs), whose pages
# cannot take the pointer lock: a lock confines the real cursor in headless Chrome on Windows
web-guard:
    node ../web/guard-scan.mjs

# `web-guard`, then the guard's test: a page that asks for the pointer lock on click never gets it. Every check recipe runs it
# first
web-guard-test: web-guard
    npm install --prefix "{{web_target}}/web-tools/node" --no-audit --no-fund --silent --save-exact puppeteer-core@24.43.1
    node ../web/guard.test.mjs

# The web level demo's check (build it first with `web-level-demo`): headless Chrome with WebGPU loads the office, waits for the
# figure, walks it and takes pictures, loads it again and counts the requests for the listed files (none: they come from the
# cache), loads it with a changed file (refused, with the message on the page), then loads the menu; fails on any console
# error. Installs puppeteer-core into the target folder's web-tools the first time and uses the installed Chrome (`CHROME`
# names another)
web-level-demo-check: web-guard-test
    npm install --prefix "{{web_target}}/web-tools/node" --no-audit --no-fund --silent --save-exact puppeteer-core@24.43.1
    node ../web/check.mjs "{{web_target}}/web/level-demo" "{{web_target}}/web/level-demo-office.png" 90 cached "?map=office"
    node ../web/check.mjs "{{web_target}}/web/level-demo" "{{web_target}}/web/level-demo-refused.png" 60 refused "?map=office"
    node ../web/check.mjs "{{web_target}}/web/level-demo" "{{web_target}}/web/level-demo-menu.png" 60 menu

# The check of the build with its files inside it (`web-level-demo-embedded`): the office walked, then the menu
web-level-demo-embedded-check: web-guard-test
    npm install --prefix "{{web_target}}/web-tools/node" --no-audit --no-fund --silent --save-exact puppeteer-core@24.43.1
    node ../web/check.mjs "{{web_target}}/web/level-demo-embedded" "{{web_target}}/web/level-demo-embedded-office.png" 90 world "?map=office"
    node ../web/check.mjs "{{web_target}}/web/level-demo-embedded" "{{web_target}}/web/level-demo-embedded-menu.png" 60 menu

# The vehicle demo in a browser (WebGPU), played alone: built for the web, then served on http://127.0.0.1:{{port}}/; its files
# fetched by their list, the loading stages and the settings as the level demo's
web-vehicle-demo port="8080":
    node ../web/build.mjs vehicle-demo
    node ../web/serve.mjs "{{web_target}}/web/vehicle-demo" {{port}}

# The web vehicle demo's check (build it first with `web-vehicle-demo`): headless Chrome from the cursor guard (`web/guard.mjs`,
# its pages never take the pointer lock) loads it, waits for the figure on the hills, walks it with W and takes pictures;
# fails on any console error
web-vehicle-demo-check: web-guard-test
    npm install --prefix "{{web_target}}/web-tools/node" --no-audit --no-fund --silent --save-exact puppeteer-core@24.43.1
    node ../web/check.mjs "{{web_target}}/web/vehicle-demo" "{{web_target}}/web/vehicle-demo-hills.png" 120 world

# The vehicle demo for browsers and desktops in one game: its browser build, then its dedicated server on UDP and the web on
# 127.0.0.1:{{port}} with WebRTC data channels, serving that build; a browser joins at http://127.0.0.1:{{port}}/?join (the
# page alone plays alone) and a desktop `vehicle-demo` joins 127.0.0.1:{{port}}. More of vehicle-demo-server's switches go
# after the port number (`--bind`, `--tls-cert`/`--tls-key`, `--rtc-public-ip`)
web-vehicle-demo-server port="28000" *args:
    node ../web/build.mjs vehicle-demo
    cargo run -p torque-example-vehicle-demo --release --bin vehicle-demo-server -- --transport both --webrtc --port {{port}} {{args}}

# A room service for player-hosted drives on 127.0.0.1:{{port}}, serving the vehicle demo's browser build: a browser hosts at
# http://127.0.0.1:{{port}}/?host=1 (its server in a Web Worker, the room's code on the page), others join at
# http://127.0.0.1:{{port}}/?room=<code>, and `vehicle-demo-server --room ws://127.0.0.1:{{port}}` hosts from a desktop. More
# switches after the port number (`--bind`, `--tls-cert`/`--tls-key`, `--stun`, `--turn`, `--turn-secret-file`)
web-vehicle-demo-rooms port="28100" *args:
    node ../web/build.mjs vehicle-demo
    cargo run -p torque-rooms --release -- --port {{port}} --web-root "{{web_target}}/web/vehicle-demo" {{args}}

# The vehicle demo's two-player checks (build it first with `web-vehicle-demo`): two headless pages join vehicle-demo-server at
# the page it serves, on data channels; then by a room's code, the server hosting the room; then the second page joins a host
# page whose server runs in a Web Worker. Each time one drives while the other watches, the other rides as the passenger and
# then walks, with no console error, and the second page says so when the host goes. Pictures into the target folder's `web`
web-vehicle-demo-mp-check: web-guard-test
    npm install --prefix "{{web_target}}/web-tools/node" --no-audit --no-fund --silent --save-exact puppeteer-core@24.43.1
    node ../web/p2p-check.mjs "{{web_target}}/web/vehicle-demo" "{{web_target}}/web/vehicle-mp-served.png" 120 served vehicle-demo
    node ../web/p2p-check.mjs "{{web_target}}/web/vehicle-demo" "{{web_target}}/web/vehicle-mp-desktop.png" 120 desktop vehicle-demo
    node ../web/p2p-check.mjs "{{web_target}}/web/vehicle-demo" "{{web_target}}/web/vehicle-mp-browser.png" 120 browser vehicle-demo

# The arena for browsers and desktops in one game: its browser build (join-only), then its dedicated server on UDP and the web
# on 127.0.0.1:{{port}}, serving that build; a browser joins at http://127.0.0.1:{{port}}/ and a desktop `fps-client` joins
# 127.0.0.1:{{port}}. More of fps-server's switches go after the port number (`--bind`, `--tls-cert`/`--tls-key`, `--map`)
web-fps port="28000" *args:
    node ../web/build.mjs fps
    cargo run -p torque-example-fps --release --bin fps-server -- --transport both --port {{port}} {{args}}

# The arena's cross-play check (build it first with `web-fps` or `node web/build.mjs fps`): fps-server on UDP and the web, a
# desktop player with no window joined over UDP, and headless Chrome joining from the server's page; both must hold the other's
# figure, the browser's walks, and no console error. Pictures into the target folder's `web`
web-fps-check: web-guard-test
    npm install --prefix "{{web_target}}/web-tools/node" --no-audit --no-fund --silent --save-exact puppeteer-core@24.43.1
    node ../web/fps-check.mjs "{{web_target}}/web/fps" "{{web_target}}/web/fps-join.png" 120

# The arena's data-channel checks (build it first as for `web-fps-check`): the browser joins on a WebRTC data channel
# beside its game socket (`fps-server --webrtc`); then with 10% of the channel's datagrams dropped both ways, its game
# messages keep arriving with no stall; then with UDP blocked in the browser it plays over the game socket
web-fps-rtc-check: web-guard-test
    npm install --prefix "{{web_target}}/web-tools/node" --no-audit --no-fund --silent --save-exact puppeteer-core@24.43.1
    node ../web/fps-check.mjs "{{web_target}}/web/fps" "{{web_target}}/web/fps-rtc.png" 120 rtc
    node ../web/fps-check.mjs "{{web_target}}/web/fps" "{{web_target}}/web/fps-rtc-loss.png" 120 rtc-loss
    node ../web/fps-check.mjs "{{web_target}}/web/fps" "{{web_target}}/web/fps-rtc-blocked.png" 120 rtc-blocked

# A room service for player-hosted games on 127.0.0.1:{{port}}, serving the arena's browser build: a desktop host opens
# a room with `fps-server --room ws://127.0.0.1:{{port}}` and prints its code, and browsers join at
# http://127.0.0.1:{{port}}/?room=<code> (or host at http://127.0.0.1:{{port}}/?host=1). More switches after the port number
# (`--bind`, `--tls-cert`/`--tls-key`, `--stun`, `--turn`, `--turn-secret-file`)
web-fps-rooms port="28100" *args:
    node ../web/build.mjs fps
    cargo run -p torque-rooms --release -- --port {{port}} --web-root "{{web_target}}/web/fps" {{args}}

# The arena hosted by a player (build it first as for `web-fps-check`): a room service serving the page, then
# `fps-server --room` with headless Chrome joining by the room's code on a data channel (it walks, then sees the host
# leave), then a host page whose server runs in a Web Worker with a second page joining it the same way
web-fps-p2p-check: web-guard-test
    npm install --prefix "{{web_target}}/web-tools/node" --no-audit --no-fund --silent --save-exact puppeteer-core@24.43.1
    node ../web/p2p-check.mjs "{{web_target}}/web/fps" "{{web_target}}/web/fps-p2p-desktop.png" 120 desktop
    node ../web/p2p-check.mjs "{{web_target}}/web/fps" "{{web_target}}/web/fps-p2p-browser.png" 120 browser

# The arena joined by an invite link on its page played alone (build it first with `node web/build.mjs fps --solo`): the
# page waits at its menu and its canvas follows the page's size; a host page makes the link, a second browser opens it and
# makes a reply link, the host's browser opens the reply, the data channel opens on this computer's own addresses (no STUN
# server is contacted), the joiner walks, bad codes are refused, a refused join takes a new link pasted in, its Back to the
# menu shows the game's menu, and the joiner leaves back to its own menu, with no page ever loaded again. Then the same with both pages in one browser, an invite on the default server (Cloudflare, not contacted:
# the pages get no STUN server) and the reply opened 20 s later. Pictures of the panels into the target folder's
# `web/invites` and `web/invites-same`
web-fps-invite-check: web-guard-test
    npm install --prefix "{{web_target}}/web-tools/node" --no-audit --no-fund --silent --save-exact puppeteer-core@24.43.1
    node ../web/invite-check.mjs "{{web_target}}/web/fps-solo" "{{web_target}}/web/invites" 120
    node ../web/invite-check.mjs "{{web_target}}/web/fps-solo" "{{web_target}}/web/invites-same" 120 same

# The invite links' connection alone, with no game and no build, in headless Chrome and headless Firefox (Firefox's
# defaults, mDNS names included; installed where `web/guard.mjs` looks, or `FIREFOX` names it): a small page runs
# `web/invites.js`, the joiner presses Connect, the reply link is opened 30 s later (a joiner's browser gives up on a host
# it cannot reach yet after a few seconds; a Firefox host's addresses answer only once it has the reply), and a message
# must go each way. One browser with two tabs, two browsers, and each browser hosting the other. No STUN server is
# contacted. Runs the guard's test in Firefox first
web-invite-link-check: web-guard-test
    node ../web/guard.test.mjs firefox
    node ../web/invite-link-check.mjs chrome same 30
    node ../web/invite-link-check.mjs firefox same 30
    node ../web/invite-link-check.mjs firefox two 30
    node ../web/invite-link-check.mjs chrome,firefox two 30
    node ../web/invite-link-check.mjs firefox,chrome two 30

# The vehicle demo joined by an invite link, as `web-fps-invite-check` (build it first with `node web/build.mjs vehicle-demo
# --solo`): its Host with a link starts its server in the worker on the same page. Pictures into the target folder's
# `web/vehicle-invites`
web-vehicle-demo-invite-check: web-guard-test
    npm install --prefix "{{web_target}}/web-tools/node" --no-audit --no-fund --silent --save-exact puppeteer-core@24.43.1
    node ../web/invite-check.mjs "{{web_target}}/web/vehicle-demo-solo" "{{web_target}}/web/vehicle-invites" 120
    node ../web/invite-check.mjs "{{web_target}}/web/vehicle-demo-solo" "{{web_target}}/web/vehicle-invites-same" 120 same

