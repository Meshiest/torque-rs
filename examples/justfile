set windows-shell := ["powershell", "-NoProfile", "-Command"]

# The build folder: CARGO_TARGET_DIR's, else the workspace's (the web builds go into its `web` folder)
web_target := env_var_or_default("CARGO_TARGET_DIR", justfile_directory() / ".." / "target")

default:
    @just --list

# The headless examples: the umbrella crate's examples and a short run of the minimal server
headless:
    cargo run -p torque --example script
    cargo run -p torque --example shape
    cargo run -p torque --example collide
    cargo run -p torque --example net
    cargo run -p torque-example --bin min-server -- --port 0 --ticks 64

# The minimal dedicated server: the bundled game on 127.0.0.1:28000 (`--ticks N` stops it after N ticks)
min-server *args:
    cargo run -p torque-example --bin min-server -- {{args}}

# The minimal client: connects to the minimal server and prints the ghosts it is sent
min-client *args:
    cargo run -p torque-example --bin min-client -- {{args}}

# The example games' asset kit (shapes and textures made from code), written into `dir`
assets dir="../target/example-assets":
    cargo run -p torque-example-assets -- {{dir}}

# The animated character example in a window (W A S D move, Shift run, Space jump, F pistol, mouse or Q/E orbit, Esc quit)
character:
    cargo run -p torque-example-character --release

# The character example's idle, walk and jump pictures, drawn offscreen into `dir`
character-shots dir="../target/character-shots":
    cargo run -p torque-example-character --release -- --shots {{dir}}

# The level demo in a window: a menu of maps, then the box figure on them (W A S D move, Shift walk, Space jump,
# mouse look, V camera, R restart, Esc menu)
level-demo:
    cargo run -p torque-example-level-demo --release

# The level demo in a browser (WebGPU): built for the web with its files inside it, then served on http://127.0.0.1:{{port}}/
# (`?map=office` starts a map at once). Needs rustup's wasm32-unknown-unknown target and Node; wasm-bindgen's command line is
# installed into the target folder's web-tools the first time
web-level-demo port="8080":
    node ../web/build.mjs level-demo
    node ../web/serve.mjs "{{web_target}}/web/level-demo" {{port}}

# The web level demo's check (build it first with `web-level-demo`): headless Chrome with WebGPU loads the office, waits for the
# figure, walks it and takes pictures, then loads the menu; fails on any console error. Installs puppeteer-core into the target
# folder's web-tools the first time and uses the installed Chrome (`CHROME` names another)
web-level-demo-check:
    npm install --prefix "{{web_target}}/web-tools/node" --no-audit --no-fund --silent puppeteer-core@24
    $env:TORQUE_WEB_TOOLS = "{{web_target}}/web-tools/node"; node ../web/check.mjs "{{web_target}}/web/level-demo" "{{web_target}}/web/level-demo-office.png" 90 world "?map=office"
    $env:TORQUE_WEB_TOOLS = "{{web_target}}/web-tools/node"; node ../web/check.mjs "{{web_target}}/web/level-demo" "{{web_target}}/web/level-demo-menu.png" 60 menu

# The level demo's pictures (the menu, and each map's overview, a view from behind the figure and from its eyes), drawn
# offscreen into `dir`
level-demo-shots dir="../target/level-demo-shots":
    cargo run -p torque-example-level-demo --release -- --shots {{dir}}

# Pictures of every shape of the asset kit for review, drawn offscreen into `dir`
kit-shots dir="../target/kit-shots":
    cargo run -p torque-example-common --release --example kit-shots -- {{dir}}

# The arena shooter's dedicated server (console only): `--bind <your LAN address>` lets others on the network join; `--port`,
# `--name`, `--map`, `--ticks N` (stop after N ticks)
fps-server *args:
    cargo run -p torque-example-fps --release --bin fps-server -- {{args}}

# The arena shooter's server open to the internet: listens on every interface (0.0.0.0) on UDP 28000 (`--port` changes it), prints
# this computer's LAN address(es), and players outside the network need that port forwarded to this computer and the firewall to
# allow it. It registers with no master server: give players your public address.
fps-server-public *args:
    cargo run -p torque-example-fps --release --bin fps-server -- --bind 0.0.0.0 --port 28000 {{args}}

# The arena shooter's client in a window: Host (a server in this process, joined at once: LAN only or public) / Join (the LAN list,
# or an address typed in) / Quit; W A S D move, mouse look, click shoot, R reload, T chat, Esc pause menu. `--bind <LAN address>`
# picks the LAN game's address, `--name <name>`
fps-client *args:
    cargo run -p torque-example-fps --release --bin fps-client -- {{args}}

# The arena shooter's headless check: a host and a second client over 127.0.0.1 meet through the LAN list, one shoots the
# other (a round spent, a hit), and a chat line reaches the other client
fps-check:
    cargo test -p torque-example-fps --test arena

# The arena shooter's review pictures (menu, LAN list, first-person view, another player, a bolt), drawn offscreen into `dir`
fps-shots dir="../target/fps-shots":
    cargo run -p torque-example-fps --release --bin fps-client -- --shots {{dir}}

# The arena's menus (main, host choice, join) at 1280x720, 1920x1080 and 2560x1080, drawn offscreen into `dir`
fps-menu-shots dir="../target/fps-menu-shots":
    cargo run -p torque-example-fps --release --bin fps-client -- --menu-shots {{dir}}

# The arena's motion pictures (side steps, the walk backward, the look, the falls, a shot's kick and flash, the reload HUD, the
# pause menu), drawn offscreen into `dir`
fps-motion-shots dir="../target/fps-motion-shots":
    cargo run -p torque-example-fps --release --bin fps-client -- --motion-shots {{dir}}

# The arena's polish pictures (a bolt's flight frame by frame into open space and at a wall, the bolts' holes, a hit seen by
# both players, aiming down the sights), drawn offscreen into `dir`
fps-polish-shots dir="../target/fps-polish-shots":
    cargo run -p torque-example-fps --release --bin fps-client -- --polish-shots {{dir}}

# The arena's second polish pictures (a shot's flares and smoke frame by frame, a bolt's ribbon from the side, bolt holes at a
# wall's middle and edge and in the floor, the sights aimed), drawn offscreen into `dir`
fps-polish2-shots dir="../target/fps-polish2-shots":
    cargo run -p torque-example-fps --release --bin fps-client -- --polish2-shots {{dir}}

# The arena's hitbox pictures: the other figure's hitboxes, as the server poses them, drawn as lines over it standing, running,
# stepping aside, looking up and down, jumping, aiming down the sights and falling, offscreen into `dir`
fps-hitbox-shots dir="../target/fps-hitbox-shots":
    cargo run -p torque-example-fps --release --bin fps-client -- --hitbox-shots {{dir}}

# The vehicle demo in a window: host a game or join one, the box figure beside a buggy on green checkerboard hills (W A S D
# move, Space jump, mouse look, click the buggy to take a seat; driving W throttle, S reverse, A D steer, Space brake, mouse
# turns the camera, E get out). `--host`, `--join <address>`, `--name <name>`, `--bind <LAN address>`
vehicle-demo *args:
    cargo run -p torque-example-vehicle-demo --release -- {{args}}

# The vehicle demo's pictures over the loopback address (the menu, the start, the buggy, its cockpit, two players seated, the
# passenger's view, the climb up the hill), drawn offscreen into `dir`
vehicle-demo-shots dir="../target/vehicle-demo-shots":
    cargo run -p torque-example-vehicle-demo --release -- --shots {{dir}}

# The vehicle demo's clouds at noon, golden hour and sunset, looking up and their shadows on the hills, with the engine's clouds
# (`engine/`) and the demo's (`demo/`), and each picture's GPU time, drawn offscreen into `dir`
vehicle-demo-cloud-shots dir="../target/vehicle-demo-cloud-shots":
    cargo run -p torque-example-vehicle-demo --release -- --cloud-shots {{dir}}

# The vehicle demo's race track, its landforms and forests in pictures (the loop from above, driver's-eye views past the
# forests, over a crest and along the ridge, up at a forest's edge, trees close up, the kinds of tree, and the low sun at
# golden hour and sunset), drawn offscreen into `dir`; `vehicle-demo-track-bench` prints the frame times at the start and
# around the lap instead
vehicle-demo-track-shots dir="../target/vehicle-demo-track-shots":
    cargo run -p torque-example-vehicle-demo --release --example track-shots -- {{dir}}

vehicle-demo-track-bench:
    cargo run -p torque-example-vehicle-demo --release --example track-shots -- --bench
