set windows-shell := ["powershell", "-NoProfile", "-Command"]

# One justfile per example, run as `just examples <example> <recipe>` from the repository root (or `just <recipe>` inside the
# example's folder). The recipes here run across several examples.

mod assets
mod character
mod common
mod format-viewer
mod fps
mod level-demo
mod minimal
mod minimal-engine
mod mods-demo
mod native-extension
mod showcase
mod vehicle-demo

default:
    @just --list --list-submodules

# The headless examples: the umbrella crate's examples and a short run of the minimal server
headless:
    cargo run -p torque --example script
    cargo run -p torque --example shape
    cargo run -p torque --example collide
    cargo run -p torque --example net
    cargo run -p torque-example-minimal --bin min-server -- --port 0 --ticks 64

# The camera's motion frame by frame, as CSV into `dir`: Tab in and out standing, walking, running, mid-turn and pressed again
# mid-way, the camera behind the figure past walls and glass (level demo, arena), and Tab while driving (vehicle demo), each at
# 60 and 144 frames a second. `--render` also draws each case's 60 fps run offscreen as numbered pictures; `--case=<name>` runs
# one case
camera-log dir="../target/camera-log" *args:
    cargo run -p torque-example-level-demo --release --example level-camera -- {{dir}}/level {{args}}
    cargo run -p torque-example-fps --release --example arena-camera -- {{dir}}/arena {{args}}
    cargo run -p torque-example-vehicle-demo --release --example vehicle-camera -- {{dir}}/vehicle {{args}}

# The HUD of the level demo, the arena and the vehicle demo for review (the view in play with the corner readout, the pause
# menu and its Controls panel) at 1280x720, 800x600 and 640x480, drawn offscreen into `dir`
hud-shots dir="../target/hud-shots":
    cargo run -p torque-example-level-demo --release --example level-hud-shots -- {{dir}}
    cargo run -p torque-example-fps --release --example arena-hud-shots -- {{dir}}
    cargo run -p torque-example-vehicle-demo --release --example vehicle-hud-shots -- {{dir}}

# What `shots-diff` accepts as the same: renders are not bit-stable from run to run, so a picture whose differing pixels are off by
# at most one level in a channel and number at most 32 passes as "near" (listed apart from the exact matches); anything more fails
shots_tolerance := "--max-delta 1 --max-pixels 32"

# Every example's offscreen pictures, each recipe's into its own folder below `dir` (the character, level demo, arena and vehicle
# demo shots, the arena's name and menu shots, the HUD shots and `showcase --examples`), to compare with `shots-diff` after a
# change. Not drawn: the clips (they need ffmpeg), the race track pictures and `showcase`'s front-page grid. Run it on the same
# machine and GPU as the folder it is compared with. `TORQUE_GPU_PARTICLES=1` in the environment draws every example's
# particles through the renderer's GPU particle pool (off by default), for the two ways' pictures compared
shots-all dir="../target/shots":
    just --justfile character/justfile shots "{{absolute_path(dir)}}/character"
    just --justfile level-demo/justfile shots "{{absolute_path(dir)}}/level-demo"
    just --justfile level-demo/justfile valley-shots "{{absolute_path(dir)}}/level-demo-valley"
    just --justfile level-demo/justfile swim-shots "{{absolute_path(dir)}}/level-demo-swim"
    just --justfile level-demo/justfile switch-shots "{{absolute_path(dir)}}/level-demo-switch"
    just --justfile fps/justfile shots "{{absolute_path(dir)}}/fps"
    just --justfile fps/justfile menu-shots "{{absolute_path(dir)}}/fps-menu"
    just --justfile fps/justfile name-shots "{{absolute_path(dir)}}/fps-name"
    just --justfile fps/justfile motion-shots "{{absolute_path(dir)}}/fps-motion"
    just --justfile fps/justfile polish-shots "{{absolute_path(dir)}}/fps-polish"
    just --justfile fps/justfile polish2-shots "{{absolute_path(dir)}}/fps-polish2"
    just --justfile fps/justfile hitbox-shots "{{absolute_path(dir)}}/fps-hitbox"
    just --justfile vehicle-demo/justfile shots "{{absolute_path(dir)}}/vehicle-demo"
    just --justfile vehicle-demo/justfile name-shots "{{absolute_path(dir)}}/vehicle-demo-name"
    just --justfile vehicle-demo/justfile switch-shots "{{absolute_path(dir)}}/vehicle-demo-switch"
    just hud-shots "{{absolute_path(dir)}}/hud"
    just --justfile showcase/justfile shots "{{absolute_path(dir)}}/showcase" --examples

# Compares two folders drawn by `shots-all`: per picture whether the sizes match, the differing pixels and the largest channel
# difference; the exit code is 1 when any picture differs. Left out: the top right corner of every picture (160x40 px), where the
# corner readout shows the frame rate measured on the clock, which differs from run to run, and the regions each example declares
# in its own `shots-ignore.txt` (other readouts measured on the clock). Pictures off by one level on at most 32
# pixels (`shots_tolerance`) pass as near and are listed apart from the exact matches. Works on the folder of a single example too;
# a relative folder is relative to `examples/`
shots-diff a b:
    cargo run -p torque-example-showcase --release --bin shots-diff -- --ignore-corner 160x40 --ignore-from "{{source_directory()}}" {{shots_tolerance}} "{{absolute_path(a)}}" "{{absolute_path(b)}}"

# `shots-diff` on one example's folder: `example` is the folder name below the `shots-all` dir (for instance `vehicle-demo`), `a`
# is the dir a run drew into and `b` the baseline dir
shots-diff-one example a b:
    just shots-diff "{{a}}/{{example}}" "{{b}}/{{example}}"
