// Plaza
// An open square with low walls, benches and a stage to climb.

new SimGroup(MissionGroup)
{
   new ScriptObject(MapInfo) { title = "Plaza"; spawn = "0 -14 0.2"; spawnYaw = 0; };
   // The ground.
   new StaticShape() { dataBlock = WorldCubeData; position = "0 0 -0.5"; scale = "48 48 1"; };
};

function addCube(%pos, %scale)
{
   MissionGroup.add(new StaticShape() { dataBlock = WorldCubeData; position = %pos; scale = %scale; });
}

function buildPlaza()
{
   // The walls round the square, a gap in the middle of each side.
   for (%side = 0; %side < 4; %side++)
   {
      for (%i = -10; %i <= 10; %i++)
      {
         if (%i >= -1 && %i <= 1)
            continue;
         %along = %i * 2;
         switch (%side)
         {
            case 0: %pos = %along SPC "22 0.75";
            case 1: %pos = %along SPC "-22 0.75";
            case 2: %pos = "22" SPC %along SPC "0.75";
            case 3: %pos = "-22" SPC %along SPC "0.75";
         }
         addCube(%pos, "2 2 1.5");
      }
   }
   // The stage in the middle: three steps up to a platform.
   addCube("0 4 0.25", "12 10 0.5");
   addCube("0 5 0.75", "9 8 0.5");
   addCube("0 6 1.25", "6 6 0.5");
   // Benches along the way in.
   for (%i = 0; %i < 4; %i++)
   {
      %y = -18 + %i * 4;
      addCube("-5" SPC %y SPC "0.25", "1 3 0.5");
      addCube("5" SPC %y SPC "0.25", "1 3 0.5");
   }
   // Four pillars at the corners of the stage.
   addCube("-8 -2 2", "1 1 4");
   addCube("8 -2 2", "1 1 4");
   addCube("-8 12 2", "1 1 4");
   addCube("8 12 2", "1 1 4");
}

buildPlaza();
