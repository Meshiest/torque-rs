set windows-shell := ["powershell", "-NoProfile", "-Command"]

# The build folder: CARGO_TARGET_DIR's, else the workspace's (the web builds go into its `web` folder)
web_target := env_var_or_default("CARGO_TARGET_DIR", module_directory() / ".." / ".." / "target")

# Where the web check's tools (puppeteer-core) are installed; exported so the recipes need no shell-specific syntax
export TORQUE_WEB_TOOLS := web_target / "web-tools" / "node"

default:
    @just --list

# The level demo in a window: a menu of maps, then the box figure on them (W A S D walk, Shift sprint, Ctrl or C crouch, Z prone,
# Space jump, mouse look, Tab camera, R restart, Esc menu). Its menu also hosts the office for others and joins theirs (Host a
# match, Join a match: the list of matches or an address), the prop catalog downloaded on joining (Q in the office). `--name`,
# `--port`, `--bind`, `--cache` after the recipe. The catalog's menu runs only with the realm guest (`just lua-client-web`, which
# needs the WASI SDK named by WASI_SDK_PATH, or TORQUE_CLIENT_GUEST); without it the office is played without the catalog
run *args:
    cargo run -p torque-example-level-demo --bin example-level-demo --release -- {{args}}

# The office server people join (console only): the office with its props, the catalog mod sent to players who lack it, on UDP
# 127.0.0.1:28000, answering the list of matches. `--bind <your LAN address>` lets others on the network join; `--port`,
# `--name`, `--ticks N`, and the web's switches (`--transport both`, `--webrtc`, `--room`)
office-server *args:
    cargo run -p torque-example-level-demo --bin example-level-demo --release --bin office-server -- {{args}}

# The office server open to the internet: every interface (0.0.0.0) on UDP 28000 (`--port` changes it); players outside the
# network need that port forwarded to this computer and the firewall to allow it
office-server-public *args:
    cargo run -p torque-example-level-demo --bin example-level-demo --release --bin office-server -- --bind 0.0.0.0 --port 28000 {{args}}

# The office for browsers and desktops in one match: the browser build with the server-scripts runner and the realm guest, then
# the office server on UDP and the web on 127.0.0.1:{{port}}, serving that build; a browser joins at
# http://127.0.0.1:{{port}}/?join and a desktop's Join a match finds it. More of the server's switches after the port number
# (`--bind`, `--webrtc`, `--tls-cert`/`--tls-key`)
office-web port="28000" *args:
    just --justfile ../../justfile --working-directory ../.. lua-client-web
    node ../../web/build.mjs level-demo --client-scripts
    cargo run -p torque-example-level-demo --bin example-level-demo --release --bin office-server -- --transport both --port {{port}} {{args}}

# A room service for an office hosted on a desktop, on 127.0.0.1:{{port}}, serving the browser build: the desktop runs
# `office-server --room ws://127.0.0.1:{{port}}` and prints its code, and browsers join at http://127.0.0.1:{{port}}/?room=<code>
office-web-rooms port="28100" *args:
    just --justfile ../../justfile --working-directory ../.. lua-client-web
    node ../../web/build.mjs level-demo --client-scripts
    cargo run -p torque-rooms --release -- --port {{port}} --web-root "{{web_target}}/web/level-demo" {{args}}

# The office's browser checks (build first with `office-web`, or `node web/build.mjs level-demo --client-scripts`): the office
# server, and headless Chrome from the cursor guard joining it over its game socket, over a WebRTC data channel, by a
# room's code, and over a WebTransport session on the QUIC link (`--webtransport`, the `quic` feature): the join screen with
# the catalog part way, the consent prompt, Allow, the catalog run in the page's Worker and a chair put down from it; no
# console error. Pictures into the target folder's `web`
office-web-check:
    just --justfile ../../justfile web-guard-test
    npm install --prefix "{{web_target}}/web-tools/node" --no-audit --no-fund --silent --save-exact puppeteer-core@24.43.1
    node ../../web/office-check.mjs "{{web_target}}/web/level-demo" "{{web_target}}/web/office-join.png" 120 join
    node ../../web/office-check.mjs "{{web_target}}/web/level-demo" "{{web_target}}/web/office-rtc.png" 120 rtc
    node ../../web/office-check.mjs "{{web_target}}/web/level-demo" "{{web_target}}/web/office-room.png" 120 room
    node ../../web/office-check.mjs "{{web_target}}/web/level-demo" "{{web_target}}/web/office-wt.png" 120 wt

# The WebTransport check alone (as `office-web-check`'s last line)
office-web-check-wt:
    just --justfile ../../justfile web-guard-test
    npm install --prefix "{{web_target}}/web-tools/node" --no-audit --no-fund --silent --save-exact puppeteer-core@24.43.1
    node ../../web/office-check.mjs "{{web_target}}/web/level-demo" "{{web_target}}/web/office-wt.png" 120 wt

# The office played with others, drawn offscreen into `dir` (no window): the menu, the list of matches, the join screen with
# the catalog part way down, the consent prompt, the catalog with a second player's plant, and the office
match-shots dir="../../target/level-demo-match-shots":
    just --justfile ../../justfile --working-directory ../.. lua-client-web
    cargo run -p torque-example-level-demo --bin example-level-demo --release -- --match-shots {{dir}}

# The level demo in a browser (WebGPU): built for the web, then served on http://127.0.0.1:{{port}}/ (`?map=office` starts a map
# at once). The page shows each loading stage, fetches the files by their list (`files.json`) and keeps them in the browser's
# cache; its gear opens the settings (the quality, Firefox starting at Low; the frame rate, also F8).
# Needs rustup's wasm32-unknown-unknown target and Node; wasm-bindgen's command line is installed into the target folder's
# web-tools the first time
web port="8080":
    node ../../web/build.mjs level-demo
    node ../../web/serve.mjs "{{web_target}}/web/level-demo" {{port}}

# `web` for the edit-and-reload loop: the module in the `web-dev` profile (no link-time optimization, no wasm-opt, incremental),
# the files of the last build kept (`node ../../web/build.mjs level-demo --dev --repack` packs them again after a change to them).
# The first run packs them as `web` does; the module is larger and slower than the release one
web-dev port="8080":
    node ../../web/build.mjs level-demo --dev
    node ../../web/serve.mjs "{{web_target}}/web/level-demo" {{port}}

# The level demo in a browser with its files inside the module (no list, nothing fetched but the page and the module)
web-embedded port="8080":
    node ../../web/build.mjs level-demo --embed
    node ../../web/serve.mjs "{{web_target}}/web/level-demo-embedded" {{port}}

# The web level demo's check (build it first with `web`): headless Chrome with WebGPU loads the office, waits for the
# figure, walks it and takes pictures, loads it again and counts the requests for the listed files (none: they come from the
# cache), loads it with a changed file (refused, with the message on the page), then loads the menu; fails on any console
# error. Installs puppeteer-core into the target folder's web-tools the first time and uses the installed Chrome (`CHROME`
# names another)
web-check:
    just --justfile ../../justfile web-guard-test
    npm install --prefix "{{web_target}}/web-tools/node" --no-audit --no-fund --silent --save-exact puppeteer-core@24.43.1
    node ../../web/check.mjs "{{web_target}}/web/level-demo" "{{web_target}}/web/level-demo-office.png" 90 cached "?map=office"
    node ../../web/check.mjs "{{web_target}}/web/level-demo" "{{web_target}}/web/level-demo-refused.png" 60 refused "?map=office"
    node ../../web/check.mjs "{{web_target}}/web/level-demo" "{{web_target}}/web/level-demo-menu.png" 60 menu

# The check of the build with its files inside it (`web-embedded`): the office walked, then the menu
web-embedded-check:
    just --justfile ../../justfile web-guard-test
    npm install --prefix "{{web_target}}/web-tools/node" --no-audit --no-fund --silent --save-exact puppeteer-core@24.43.1
    node ../../web/check.mjs "{{web_target}}/web/level-demo-embedded" "{{web_target}}/web/level-demo-embedded-office.png" 90 world "?map=office"
    node ../../web/check.mjs "{{web_target}}/web/level-demo-embedded" "{{web_target}}/web/level-demo-embedded-menu.png" 60 menu

# The level demo's pictures (the menu, and each map's overview, a view from behind the figure and from its eyes), drawn
# offscreen into `dir`
shots dir="../../target/level-demo-shots":
    cargo run -p torque-example-level-demo --bin example-level-demo --release -- --shots {{dir}}

# The level demo with the rope plugin (the `rope` feature): the plaza's clothesline hung between its front pillars, from behind the figure,
# from the front, thrown up and swinging, drawn offscreen into `dir`
rope-shots dir="../../target/level-demo-rope-shots":
    cargo run -p torque-example-level-demo --bin example-level-demo --release --features rope -- --rope-shots {{dir}}

# The level demo's rope styles (the `rope` feature): a ribbon cable and glowing laser lines beside the clothesline, the figure with
# a laser through and behind it and a ribbon across in front, the camera looking almost along a ribbon, and a thin laser from far
# away, drawn offscreen into `dir`
rope-style-shots dir="../../target/level-demo-rope-style-shots":
    cargo run -p torque-example-level-demo --bin example-level-demo --release --features rope -- --rope-style-shots {{dir}}

# A correction the server forces on the plaza's figure (moved 1.2 units sideways), frame by frame, with TGE's predictor and with
# the smoothed one (the `smooth-prediction` feature), from beside the figure and from the game's camera, drawn offscreen into
# `dir` (`correction-strip.png` has the four sequences in rows)
correction-shots dir="../../target/level-demo-correction-shots":
    cargo run -p torque-example-level-demo --bin example-level-demo --release --features smooth-prediction -- --correction-shots {{dir}}

# The level demo's valley (its lake at golden hour, its woods and mountains) from a few places, the world alone, drawn offscreen
# into `dir`
valley-shots dir="../../target/level-demo-valley-shots":
    cargo run -p torque-example-level-demo --bin example-level-demo --release -- --valley-shots {{dir}}

# The figure swimming in the valley's lake (mid-stroke from beside it, from the camera behind it, and treading water), drawn
# offscreen into `dir`
swim-shots dir="../../target/level-demo-swim-shots":
    cargo run -p torque-example-level-demo --bin example-level-demo --release -- --swim-shots {{dir}}

# The figure in the valley from behind and from its eyes, looking down, level and up (`Tab` keeps where the view looks), drawn
# offscreen into `dir`
switch-shots dir="../../target/level-demo-switch-shots":
    cargo run -p torque-example-level-demo --bin example-level-demo --release -- --switch-shots {{dir}}

# The level demo's prop catalog, headless: the office's server requires the catalog mod of its clients, two clients download it, allow its
# menu and spawn props from it. Builds the realm guest first (`just lua-client-web`: the WASI SDK, named by WASI_SDK_PATH);
# TORQUE_CLIENT_GUEST names a built one instead
catalog:
    just --justfile ../../justfile --working-directory ../.. lua-client-web
    cargo run -p torque-example-level-demo --bin example-level-demo --release --example level-catalog

# The catalog's pictures (the consent prompt, the catalog, a label typed and the recent list, a chair in the office, a refusal), drawn
# offscreen into `dir`
catalog-shots dir="../../target/level-catalog-shots":
    just --justfile ../../justfile --working-directory ../.. lua-client-web
    cargo run -p torque-example-level-demo --bin example-level-demo --release --example level-catalog -- --shots {{dir}}

# The catalog's end-to-end tests (level-demo's tests/catalog.rs, and tests/multiplayer.rs: the office server on UDP, the list
# of matches, the download, Allow, a prop another player picks up, a second join from the cache), with the guest
# `lua-client-web` builds
catalog-test:
    just --justfile ../../justfile --working-directory ../.. lua-client-web
    $env:TORQUE_CLIENT_GUEST = "{{web_target}}/lua-web/torque_lua_client.wasm"; $env:TORQUE_CLIENT_GUEST_REQUIRED = "1"; cargo test -p torque-example-level-demo --test main -- --include-ignored catalog:: multiplayer::

# The catalog's pictures (the mod's `icons/`): each kind of the office's props drawn from its shape on a plain floor by a fixed camera,
# offscreen (no window), 128 x 128, into `dir` (the mod's own folder by default)
catalog-icons dir="catalog/icons":
    cargo run -p torque-example-level-demo --bin example-level-demo --release --example catalog-icons -- {{dir}}
