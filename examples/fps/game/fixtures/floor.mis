// A test floor: one flat square and two spawn points six units apart, facing each other.

new SimGroup(MissionGroup)
{
   new Sky(FloorSky) { visibleDistance = 1500; fogDistance = 400; fogColor = "0.72 0.8 0.9 1"; useSkyTextures = false; };
   new StaticShape(Floor) { dataBlock = ArenaCube; position = "0 0 -0.5"; scale = "40 40 1"; };
};

$Arena::Spawn[0] = "0 -6 0.1 0";
$Arena::Spawn[1] = "0 6 0.1 3.14159";
$Arena::SpawnCount = 2;
