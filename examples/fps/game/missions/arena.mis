// The arena: one interior (the kit's `arena.dif`, built from boxes in code): a walled square of 40 units with cover taller than
// a figure (2.4 units: a standing figure's head tops out near 2), two low platforms with steps, a block in the middle and stacks of
// crates.

new SimGroup(MissionGroup)
{
   // Sharp texels: the arena drawn with nearest-neighbor filtering (a map that names no filter keeps it smooth).
   textureFilter = "nearest";
   // The view reaches far across the arena, with a light haze toward its edges.
   new Sky(ArenaSky)
   {
      visibleDistance = 1500;
      fogDistance = 400;
      fogColor = "0.72 0.8 0.9 1";
      useSkyTextures = false;
   };
   new InteriorInstance(Arena)
   {
      position = "0 0 0";
      rotation = "1 0 0 0";
      scale = "1 1 1";
      interiorFile = "kit/arena.dif";
   };
};

// Where figures start: "x y z yaw", each facing the middle.
$Arena::Spawn[0] = "0 -16 0.1 0";
$Arena::Spawn[1] = "0 16 0.1 3.14159";
$Arena::Spawn[2] = "-16 0 0.1 1.5708";
$Arena::Spawn[3] = "16 0 0.1 -1.5708";
$Arena::Spawn[4] = "-17.5 -17.5 0.1 0.7854";
$Arena::Spawn[5] = "17.5 17.5 0.1 3.927";
$Arena::SpawnCount = 6;
